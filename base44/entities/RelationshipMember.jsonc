{
  "name": "RelationshipMember",
  "type": "object",
  "properties": {
    "relationship_id": {
      "type": "string",
      "description": "ID of the relationship"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the member"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID of the member \u2014 nullable, populated on new writes and via backfill"
    },
    "display_name": {
      "type": "string",
      "description": "Optional display name within this relationship"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member",
        "read_only"
      ],
      "default": "member",
      "description": "Permission role within this relationship"
    },
    "can_invite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this member (role=member) can invite others"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "removed"
      ],
      "default": "active",
      "description": "Membership status"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation was sent (for expiry tracking)"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of the user who invited this member"
    },
    "data_preference": {
      "type": "string",
      "enum": [
        "delete_on_leave",
        "retain_on_leave",
        "require_approval",
        "ask_later"
      ],
      "default": "ask_later",
      "description": "This member's own preference for what happens to their contributions if they permanently leave the relationship. Owned solely by this member \u2014 never set or overridden by anyone else. delete_on_leave = erase my contributions if I leave; retain_on_leave = my contributions may remain; require_approval = ask me for approval before any deletion; ask_later = undecided, ask me later. The erasure workflow itself is not yet implemented \u2014 this field only records the preference."
    },
    "shared_history_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this member acknowledged that leaving a space does not automatically delete shared history. Owned solely by this member \u2014 never set or overridden by anyone else. Null until acknowledged."
    }
  },
  "required": [
    "relationship_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.relationship_id": {
            "$in": [
              "{{lookup.Relationship.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}