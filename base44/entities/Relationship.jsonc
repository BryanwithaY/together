{
  "name": "Relationship",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the relationship"
    },
    "type": {
      "type": "string",
      "enum": [
        "romantic_partner",
        "romantic_group",
        "friends",
        "friend_group",
        "parent_adult_child",
        "siblings",
        "family",
        "co_parents",
        "business_partners",
        "cofounders",
        "other"
      ],
      "description": "Type of relationship"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who created/owns this relationship"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the relationship photo or image"
    },
    "max_members": {
      "type": "number",
      "description": "Maximum number of members (2-10)"
    },
    "allow_private_moments": {
      "type": "boolean",
      "default": true,
      "description": "Whether members can create visibility=tagged_only moments"
    },
    "allow_export": {
      "type": "boolean",
      "default": true,
      "description": "Whether data export is enabled for this relationship"
    },
    "feed_order": {
      "type": "string",
      "enum": [
        "chronological",
        "recent_activity"
      ],
      "default": "chronological",
      "description": "Default feed ordering"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete flag"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this relationship has been archived (locked, read-only)"
    },
    "last_moment_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last moment was logged in this relationship"
    },
    "total_moments": {
      "type": "number",
      "default": 0,
      "description": "Total moments logged in this relationship"
    },
    "member_count": {
      "type": "number",
      "default": 1,
      "description": "Number of active members"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Base44 user IDs of active members \u2014 mirrors active RelationshipMember.user_id rows, kept in sync so RLS can check membership directly on this record (RLS cannot cross-reference other entities by id)."
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of active members \u2014 mirrors active RelationshipMember.user_email rows, fallback for members whose user_id hasn't been backfilled yet."
    },
    "has_shared_history": {
      "type": "boolean",
      "default": false,
      "description": "Durable one-way flag. Once set true (because more than one person was ever an active member, or another user authored a moment/schedule in this space), it is NEVER reset to false, even if the space later appears solo again. Used to permanently block deletion of spaces that ever had shared participation."
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "temporary",
        "shared_memory",
        "permanent_record"
      ],
      "description": "How durable/sensitive this relationship's shared history is considered. Derived from relationship type at creation time, editable later. Drives the sensible default for lifecycle_policy. temporary = short-lived (travel, project, event); shared_memory = ongoing personal relationships (friends, partners, families); permanent_record = high-stakes/durable records (marriage, co-parenting, family, medical, legal)."
    },
    "lifecycle_policy": {
      "type": "string",
      "enum": [
        "archive_only",
        "destroy_with_consent",
        "destroy_solo_only",
        "never_destroy"
      ],
      "description": "Governs whether/how this relationship container can ever be destroyed (independent from any individual member's personal data preference). archive_only = can be archived but never destroyed; destroy_with_consent = destruction requires unanimous member consent (workflow not yet implemented); destroy_solo_only = may only be destroyed while it has never had shared history (today's existing solo-deletion rule); never_destroy = archive is the only end state. Defaulted from trust_level at creation, editable later by the owner."
    }
  },
  "required": [
    "name",
    "type",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}",
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}